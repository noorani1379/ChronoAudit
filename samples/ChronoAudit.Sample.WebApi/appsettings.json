{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LibraryDb": "<set in environment>"
  },
  "ChronoAudit": {
    "Provider": "SqlServer",
    "Audit": {
      "SystemUserId": "System",
      "SystemDisplayName": "System",
      "DelegatedDisplayNameFormat": "{0} (on behalf)",
      "BacklogWarnRows": 1000
    },
    "Anchors": {
      "Directory": "App_Data/chronoaudit-anchors",
      "IntervalHours": 24,
      "StartupDelaySeconds": 60,
      "VerifyWindowRows": 10000
    },
    "Store": {
      "Schema": "chronoaudit"
    },
    "ActivityLog": {
      "ExcludedPathPrefixes": [ "/health", "/version", "/swagger", "/hubs" ],
      "HashIntervalSeconds": 10,
      "HashBatchSize": 500,
      "IncompleteIntentAgeMinutes": 5
    },
    "Masking": {
      "MaxBodyBytes": 65536,
      "CodeIsSecretPathFragments": [ "/auth/", "/otp/", "/sessions/" ]
    },
    "PersonalData": {
      "NumberFields": [ "PhoneNumber" ],
      "TextFields": [ "FullName", "Email" ]
    },
    "DataLag": {
      "CacheSeconds": 3
    },
    "Consistency": {
      "IntervalHours": 6,
      "GraceSeconds": 60
    },
    "AspNetCore": {
      "CorrelationHeader": "X-Correlation-Id"
    },
    "Exports": {
      "Directory": "App_Data/chronoaudit-exports",
      "RetentionDays": 7,
      "LeaseSeconds": 120,
      "PollIntervalSeconds": 5,
      "MaxRows": 5000000,
      "MaxActivePerUser": 3,
      "BatchSize": 1000
    },
    "PreviousHmacKeys": [],
    "Calendar": {
      "Kind": "Gregorian",
      "TimeZoneId": "UTC"
    }
  }
}
